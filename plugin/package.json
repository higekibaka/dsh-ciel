{
  "name": "dsh-advisor",
  "version": "0.10.0",
  "description": "Pre-planning advisor for DeepSeek Harness: a second, knowledge-rich model the agent consults before planning — ideas only, never steps. Configurable under Settings → Plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-harness/dsh-advisor.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "advisor",
    "planning",
    "second-model",
    "plugin"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
