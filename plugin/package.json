{
  "name": "dsh-ciel",
  "version": "0.14.0",
  "description": "夏尔 Ciel — DeepSeek Harness 的规划前顾问：第二个知识广博的模型在动手前提供方向、先例、陷阱与验证清单（主意，不是步骤）。命名灵感：转生史莱姆的大贤者夏尔。Settings → Plugins 可配。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/higekibaka/dsh-ciel.git"
  },
  "bugs": "https://github.com/higekibaka/dsh-ciel/issues",
  "homepage": "https://github.com/higekibaka/dsh-ciel#readme",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "advisor",
    "planning",
    "second-model",
    "plugin"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
